{
  "manifest_version": 3,
  "name": "TravelMate Agent - Smart Bus Booking",
  "version": "1.1.0",
  "description": "Autonomous TravelMate AI booking agent for RedBus. Compares buses, ranks options, and assists with seat booking directly on the active tab.",
  "permissions": [
    "sidePanel",
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.redbus.in/*",
    "https://s3-ap-southeast-1.amazonaws.com/*",
    "https://s3.rdbuz.com/*",
    "https://st.redbus.in/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https: blob:;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open TravelMate Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.redbus.in/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "icons/*"
      ],
      "matches": ["https://*.redbus.in/*"]
    }
  ]
}
